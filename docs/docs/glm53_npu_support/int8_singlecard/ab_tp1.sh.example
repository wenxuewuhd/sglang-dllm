#!/bin/bash
# One A/B point for the INT8 single-card study: restart the TP1 server with the
# given MODEL/env, wait until it is really up, and time decode at bs=1 and bs=16.
#
# The wait after the kill is not optional and not a timer.  Killing the server
# does not return HBM immediately, and bootstrap.py's "each die >=90% free"
# check will happily let the next process start and then blow up in the middle
# of loading weights -- which looks like "not enough memory" and is actually
# "the last process had not exited".  So we wait for npu-smi to say so.
#
#   NAME=kdaint8 MODEL=/var/tmp/glm53/...-kdaint8 ./ab_tp1.sh
#   NAME=tqe2 TQE=2 ./ab_tp1.sh
set -u
NAME=${NAME:?set NAME}
DIE=${DIE:-0}
PORT=${PORT:-30013}
RUN=${GLM53_ROOT}/env/run
LOG=$RUN/glm_w8a8_tp1_${NAME}_$(date +%H%M).log

# Kill only *our* server, by port. `pkill -f "[s]glang.launch_server"` matches every
# sglang process this OS user owns, and there is a second session working on the same
# box -- it took down their TP8 run mid-GSM8K on 2026-08-30. The bracket keeps the
# pattern from matching pkill's own command line.
pkill -f -- "[-]-port ${PORT}" 2>/dev/null
echo "waiting for die $DIE to come back to idle..."
# Physical die $DIE is the (DIE+1)-th HBM figure npu-smi prints (the phy-id
# column runs 0..15 in order).
#
# The \s* in the pattern is load-bearing.  npu-smi pads the used-MiB field to a
# fixed width, so an idle die prints "2880 / 65536" but a busy one prints
# "33861/ 65536" with no space.  A pattern written '(?= / 65536)' therefore drops
# exactly the dies that are busy, the list shifts up by one, and the check reads
# some *other* die's idle number and lets you through -- straight into an OOM
# during weight loading.  Measured 2026-08-30 with a die at 33861 MiB: strict
# pattern returned 15 numbers, loose returned 16.
die_used() { npu-smi info | grep -oP '\d+(?=\s*/ 65536)' | sed -n "$((DIE + 1))p"; }
until [ "$(die_used)" -lt 6553 ]; do
    sleep 10
done
echo "die $DIE free: $(die_used) MiB used"

nohup bash $RUN/launch_glm_w8a8_tp1.sh > $LOG 2>&1 &
echo "log $LOG"

# Fail fast on a collision instead of OOMing thirty seconds later. The idle check
# above is a snapshot: a third user on this box runs 16-die DSv4 training, and one
# of those starts landed inside our weight load on 2026-08-30 -- the die was at
# 3135 MiB when we looked and at 55 GB by the time the MoE reached create_weights.
# `Load weight begin. avail mem=` is the first number printed after the device is
# really ours, so it is the earliest point a collision is visible. A healthy start
# on this configuration reports ~60.8 GB.
for i in $(seq 1 120); do
    grep -q "Load weight begin" $LOG && break
    grep -qE "Traceback|out of memory" $LOG && break
    sleep 5
done
AVAIL=$(grep -oP 'Load weight begin\. avail mem=\K[0-9.]+' $LOG | head -1)
if [ -n "$AVAIL" ] && [ "$(echo "$AVAIL < 58" | bc -l 2>/dev/null || echo 0)" = "1" ]; then
    echo "ABORT: only ${AVAIL} GB free at load time (expect ~60.8) -- someone else took the die."
    echo "       This is a collision, not a regression in whatever you were testing."
    npu-smi info -t proc-mem -i $DIE -c 0 2>/dev/null | head -5
    pkill -f -- "[-]-port ${PORT}" 2>/dev/null
    exit 2
fi
for i in $(seq 1 240); do
    grep -q "server is fired up" $LOG && break
    grep -qE "Traceback|out of memory" $LOG && { echo "FAILED:"; tail -25 $LOG; exit 1; }
    sleep 5
done
grep -q "server is fired up" $LOG || { echo "TIMEOUT"; tail -25 $LOG; exit 1; }
grep -E "Load weight end|Mamba Cache|KV Cache|Capture target decode NPU graph end" $LOG

set +u  # env.sh sources CANN set_env scripts that read unset variables
source ${GLM53_ROOT}/env/env.sh
cd ${GLM53_ROOT}/wt-int8-singlecard/docs/docs/glm53_npu_support/tools

# Warm up before timing anything.  bench_graph_decode subtracts a max_new_tokens=1
# run from a max_new_tokens=DEC+1 run, so a cold first request does not just add
# noise -- it lands entirely in the term being SUBTRACTED and makes decode look
# faster than it is.  Measured 2026-08-30: a cold server reported 30.7 ms/token
# where the true figure was 42.4, purely because the prefill leg took 1.88 s
# instead of 0.39 s.
curl -s -m 300 -X POST http://127.0.0.1:$PORT/generate \
    -H 'Content-Type: application/json' \
    -d '{"text":"warmup","sampling_params":{"max_new_tokens":32,"temperature":0,"ignore_eos":true}}' \
    > /dev/null
$VENV/bin/python bench_graph_decode.py --port $PORT \
    --concurrency ${CONC:-1,4,16} --decode-tokens ${DECTOK:-128} --pools ${POOLS:-short} 2>&1 | tee /var/tmp/glm53/bench_${NAME}.log
