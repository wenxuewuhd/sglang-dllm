#!/bin/bash
# D① 长上下文：INT8 W8A8 TP8，die 8-15，端口 30023。
# 与 launch_glm_w8a8_tp8.sh 的差别，逐条都有理由：
#   --context-length ${CTX}        阶梯拉长的那个旋钮（32768 -> 1048576）
#   --max-running-requests ${MAXREQ:-8}
#       ⚠ **1M 下必须显式传**。不传时 kv_cache_configurator.resolve_max_num_reqs
#       走 estimated = token_capacity/context_len*512 然后 max(min(est,4096),2048)
#       —— 那个 2048 的下界与 context_len 无关，1M 下会把 req_to_token 顶到
#       2049 x 1048580 x 4B = 8.6 GB/die，而且它是在 KV 池定容**之后**分配的，
#       不从 KV 预算里扣。传 8 -> 34 MB。
#       顺带把 mamba 池压到 8 槽（约 0.14 GB，128 槽是 2.22 GB）。
#   --mem-fraction-static ${MEMFRAC:-0.90}
#       0.85 时 TP8 INT8 只有 939712 token（mrr=128）。1M 需要 13.75 GiB KV
#       （实测 14080 B/token：11 个 DSA 层 x 512 x 2B + 11 x 128 x 2B 索引缓存）。
#       ⚠ 提高它同时会放大 _zero_rope 的 O(KV池) 缓存（1.24M token 时 159 MiB）。
#   --disable-radix-cache 保留：causal_conv1d_fn_npu 混合 has_initial_state 会写坏
#       冷请求的 conv state（PLAN P6.2），开着它出来的长上下文召回数字不可信。
set -x
export ASCEND_RT_VISIBLE_DEVICES=8,9,10,11,12,13,14,15
source $ROOT/env.sh
export PYTHONNOUSERSITE=1
export PYTHONPATH=$REPO/python:$PYTHONPATH

export PYTORCH_NPU_ALLOC_CONF=expandable_segments:True
export STREAMS_PER_DEVICE=32
export INF_NAN_MODE_FORCE_DISABLE=1
export TASK_QUEUE_ENABLE=1
export SGLANG_SET_CPU_AFFINITY=1

export SGLANG_OPT_DEEPGEMM_HC_PRENORM=False
export SGLANG_OPT_FP8_WO_A_GEMM=0
export SGLANG_OPT_BF16_FP32_GEMM_ALGO=torch
export SGLANG_OPT_USE_FUSED_HASH_TOPK=False
unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
ulimit -n 65536

PORT=${PORT:-30023}
exec $VENV/bin/python -m sglang.launch_server \
    --model-path /mnt/workspace/models/GLM-5.3-Flash-W8A8 \
    --trust-remote-code \
    --device npu \
    --tp-size 8 \
    --moe-a2a-backend none \
    --dtype bfloat16 --kv-cache-dtype auto \
    --page-size 64 \
    --chunked-prefill-size ${CHUNK:-8192} \
    --max-running-requests ${MAXREQ:-8} \
    --context-length ${CTX:-32768} \
    --mem-fraction-static ${MEMFRAC:-0.90} \
    --disable-radix-cache \
    --cuda-graph-max-bs-decode ${MAXREQ:-8} \
    --skip-server-warmup \
    --watchdog-timeout 9000 \
    --host 127.0.0.1 --port ${PORT}
