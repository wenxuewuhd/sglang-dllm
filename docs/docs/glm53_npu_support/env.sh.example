# 复制到 $ROOT/env.sh 使用。用法：source env.sh，然后用 npy 代替 python。
#!/bin/bash
# GLM-5.3-Flash 昇腾开发环境（Ubuntu 24.04 / glibc 2.39 / libstdc++ 13）。
# 24.04 覆盖了预编译 .so 需要的 GLIBC_2.34 + GLIBCXX_3.4.29，
# 所以不再需要 20.04 那套独立 loader 绕行（SETUP.md 附录 B）。
# ⚠ 先设 GLM53_ROOT 指向你的工作目录（见 README 开头），否则下面两行展开成空路径。
: "${GLM53_ROOT:?set GLM53_ROOT to your workspace directory first}"
export ROOT=${GLM53_ROOT}/env
export REPO=${GLM53_ROOT}/sglang-dllm

unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY   # 代理只对 github/anthropic 有效
unset LD_PRELOAD                                       # 系统预置的 libgomp 会干扰 torch_npu 的 FunctionLoader

source /home/developer/Ascend/ascend-toolkit/set_env.sh
source $ROOT/opp_custom/vendors/customize/bin/set_env.bash
source $ROOT/opp_custom/vendors/custom_transformer/bin/set_env.bash
export ASCEND_CUSTOM_OPP_PATH=$ROOT/opp_custom/vendors/custom_transformer:$ROOT/opp_custom/vendors/customize

export VENV=$ROOT/.venv-glm53
export PATH=$VENV/bin:$PATH
npy() { $VENV/bin/python "$@"; }
