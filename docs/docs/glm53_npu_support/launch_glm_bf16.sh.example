#!/bin/bash
# GLM-5.3-Flash BF16 bring-up（P3）。纯 TP16：GLM 的 64/64/32/288 都能被 16 整除，
# 不需要 DSv4 那种 DP-attention（DSv4 是被 o_groups=8 逼的，GLM 没有那个字段）。
set -x
source $ROOT/env.sh
export PYTHONNOUSERSITE=1
export PYTHONPATH=$REPO/python:$PYTHONPATH

export PYTORCH_NPU_ALLOC_CONF=expandable_segments:True
export STREAMS_PER_DEVICE=32
export INF_NAN_MODE_FORCE_DISABLE=1
export TASK_QUEUE_ENABLE=1
export SGLANG_SET_CPU_AFFINITY=1

# ⚠ 下面四个开关是 mHC 接到昇腾融合算子（commit 1cc9eda1c5）**之前**的绕行。
# 源码核查（2026-08-28）显示 GLM 在 NPU 上现在四条**都走不到**：
#   DEEPGEMM_HC_PRENORM  消费点是 mhc_pre() / mhc_fused_post_pre()，而
#                        _mhc_pre_dispatch / _mhc_post_dispatch 都在 _is_npu 上提前返回；
#                        后者只被 deepseek_v4.py 引用
#   FP8_WO_A_GEMM        消费点在 deepseek_v4.py:218 —— 那是 DSv4 的模型文件
#   BF16_FP32_GEMM_ALGO  消费点 dsv4/gemm.py 在 GLM 的 NPU 路径上到不了；而且
#                        "torch" **不是合法取值**，它落进 else 分支到
#                        _linear_bf16_fp32_cublas，那个函数的非 CUDA 兜底恰好是
#                        torch.mm(x.float(), ...)。能跑，但机制和名字不是一回事
#   USE_FUSED_HASH_TOPK  消费点 hash_topk.py:232 本来就写着 and not _is_npu
#
# **仍然保留**：整网基线还没跑通过，不要在那次高成本的启动里同时引入新变量。
# 基线跑通之后再逐个去掉验证 —— 那时失败的代价只是一次重启。
#
# 结构性问题：server_args.py 有 is_sm120_supported() 和 is_hip() 两个平台块自动设这些
# 开关，**没有 is_npu() 块**，所以每个 NPU 部署都得在启动脚本里手工猜一遍。
export SGLANG_OPT_DEEPGEMM_HC_PRENORM=False
export SGLANG_OPT_FP8_WO_A_GEMM=0
export SGLANG_OPT_BF16_FP32_GEMM_ALGO=torch
export SGLANG_OPT_USE_FUSED_HASH_TOPK=False
unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
ulimit -n 65536

# 图相关的默认配方（2026-08-29 实测）：
#   去掉 --disable-cuda-graph        这才是开图。decode 约 8x（27.5 vs 220-238 ms/token）
#   去掉 --disable-overlap-schedule  实测 **1.23x**（GSM8K 那种负载 248 -> 304 token/s），
#                                    而且对 eager 基线仍然逐位相同。此前关着只是为了让
#                                    graph-vs-eager 的对拍只有一个变量
#   --cuda-graph-max-bs-decode 128   要和 --max-running-requests 一致。不设的话 max_bs
#                                    默认 **256**，会去捕 36 个桶，而大于并发上限的桶
#                                    永远用不上：白花捕获时间和图池显存
#   --max-running-requests 128       卡并发的是 KDA 的 mamba state pool（每槽 8.75 MB/die），
#                                    不是 KV。128 槽只要 1.11 GB；短上下文到 128 还没饱和
#
# ⚠ **prefill 图不用试着开** —— 加 --disable-prefill-cuda-graph 或去掉它都没用：
#   NPU 上 prefill 默认后端是 tc_piecewise，而 server_args.py 的兼容性规则第一条
#   「non-CUDA hardware」就把它整个否掉了。要开是两件代码工作，见 PLAN P6.14。
#
# 要回 eager 基线（对拍用）：加回 --disable-cuda-graph。
#
# ⚠ 换配置重启前，**等 npu-smi 自己说话**，别看秒表：kill 后 3 秒重起，
# `bootstrap.py:339` 的 90% 检查会放行，然后在加载权重时炸 OOM。16 个 die 全部
# 回到约 3 GB 实测要 2–3 分钟：
#   until [ "$(npu-smi info | grep -oP '\d+(?=\s*/ 65536)' | awk '$1>6553{c++}END{print c+0}')" = 0 ]; do sleep 15; done

PORT=${PORT:-30003}
exec $VENV/bin/python -m sglang.launch_server \
    --model-path /mnt/workspace/models/GLM-5.3-Flash-BF16 \
    --trust-remote-code \
    --device npu \
    --tp-size 16 \
    --moe-a2a-backend none \
    --dtype bfloat16 --kv-cache-dtype auto \
    --page-size 64 \
    --max-running-requests 128 \
    --context-length 32768 \
    --mem-fraction-static 0.85 \
    --disable-radix-cache \
    --cuda-graph-max-bs-decode 128 \
    --skip-server-warmup \
    --watchdog-timeout 9000 \
    --host 127.0.0.1 --port ${PORT}
